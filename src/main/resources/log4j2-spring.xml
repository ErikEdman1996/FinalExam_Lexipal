<configuration status="warn">
    <properties>
        <property name="LOG_PATTERN_GENERAL">%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n</property>
        <property name="LOG_DIR">logs</property>
    </properties>
    <appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%style{%d{HH:mm:ss.SSS}}{cyan} [%style{%t}{magenta}] %highlight{%-5level} %style{%logger{36}}{blue} - %msg%n" />
        </Console>
        <RollingFile name="AppFile" fileName="${LOG_DIR}/app.log"
                     filePattern="${LOG_DIR}/app-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${LOG_PATTERN_GENERAL}"/>
            <Policies>
                <TimeBasedTriggeringPolicy />
                <SizeBasedTriggeringPolicy size="10MB"/>
            </Policies>
        </RollingFile>
        <RollingFile name="UserFile" fileName="${LOG_DIR}/user.log"
                     filePattern="${LOG_DIR}/user-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %highlight{%-5level} %logger{36} - %msg%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy />
                <SizeBasedTriggeringPolicy size="5MB"/>
            </Policies>
        </RollingFile>
        <RollingFile name="BookFile" fileName="${LOG_DIR}/books.log"
                     filePattern="${LOG_DIR}/book-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %highlight{%-5level} %logger{36} - %msg%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy />
                <SizeBasedTriggeringPolicy size="5MB"/>
            </Policies>
        </RollingFile>
        <RollingFile name="SessionFile" fileName="${LOG_DIR}/session.log"
                     filePattern="${LOG_DIR}/session-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %highlight{%-5level} %logger{36} - %msg%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy />
                <SizeBasedTriggeringPolicy size="5MB"/>
            </Policies>
        </RollingFile>
        <RollingFile name="CapturedWordFile" fileName="${LOG_DIR}/captured_word.log"
                     filePattern="${LOG_DIR}/captured-word-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %highlight{%-5level} %logger{36} - %msg%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy />
                <SizeBasedTriggeringPolicy size="5MB"/>
            </Policies>
        </RollingFile>
    </appenders>
    <loggers>
        <logger name="UserLogger" level="info" additivity="false">
            <appender-ref ref="UserFile"/>
        </logger>
        <logger name="BookLogger" level="info" additivity="false">
            <appender-ref ref="BookFile"/>
        </logger>
        <logger name="CapturedWordLogger" level="info" additivity="false">
            <appender-ref ref="CapturedWordFile"/>
        </logger>
        <logger name="SessionLogger" level="info" additivity="false">
            <appender-ref ref="SessionFile"/>
        </logger>
        <root level="info">
            <appender-ref ref="Console"/>
            <appender-ref ref="AppFile"/>
        </root>
    </loggers>
</configuration>