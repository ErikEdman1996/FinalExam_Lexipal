<configuration status="warn">
    <properties>
        <property name="LOG_PATTERN_GENERAL">%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n</property>
        <property name="LOG_DIR">logs</property>
    </properties>
    <appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%style{%d{HH:mm:ss.SSS}}{cyan} [%style{%t}{magenta}] %highlight{%-5level} %style{%logger{36}}{blue} - %msg%n" />
        </Console>
        <RollingFile name="AppFile" fileName="${LOG_DIR}/app.log"
                     filePattern="${LOG_DIR}/app-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${LOG_PATTERN_GENERAL}"/>
            <Policies>
                <TimeBasedTriggeringPolicy />
                <SizeBasedTriggeringPolicy size="10MB"/>
            </Policies>
        </RollingFile>
        <RollingFile name="ServiceFile" fileName="${LOG_DIR}/services.log"
                     filePattern="${LOG_DIR}/services-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %highlight{%-5level} %logger{36} - %msg%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy />
                <SizeBasedTriggeringPolicy size="10MB"/>
            </Policies>
        </RollingFile>
    </appenders>
    <loggers>
        <logger name="com.lexipal" level="info" additivity="false">
            <appender-ref ref="Console"/>
            <appender-ref ref="AppFile"/>
            <appender-ref ref="ServiceFile"/>
        </logger>
        <root level="warn">
            <appender-ref ref="Console"/>
            <appender-ref ref="AppFile"/>
        </root>
    </loggers>
</configuration>
